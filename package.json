{
  "name": "converge",
  "version": "1.2.0",
  "description": "CONVERGE — Human x AI continuous collaboration workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check src/store.js && node --check tests/store.test.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.worldwideadsnetonline.converge",
    "productName": "CONVERGE",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CONVERGE-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}\n