{
  "name": "converge-dj-studio",
  "version": "0.3.4",
  "description": "Four-deck DJ workstation with individual crossfader routing and beat-aligned sync",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.converge.djstudio",
    "productName": "CONVERGE DJ Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CONVERGE-DJ-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
